APP_NAME=CampusEncontra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de dados
# ---------------------------------------------------------------------------
# Local rápido (SQLite). Para o projecto, PostgreSQL é a referência.
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# PostgreSQL local (Laragon) ou alojado (Neon, Supabase, Railway, etc.)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=campus_encontra
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=prefer
# Em serviços geridos usa normalmente DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Sessões e autenticação
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Domínios que podem usar autenticação por cookie (SPA no mesmo domínio).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000
# Duração do token Bearer em minutos (10080 = 7 dias). Vazio = sem expiração.
SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=ce_

# Origens autorizadas a chamar a API (separadas por vírgulas).
# Em produção: CORS_ALLOWED_ORIGINS=https://campus-encontra.exemplo.pt
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:8000,http://127.0.0.1:5173

# Proxies de confiança (ex.: load balancer do alojamento). Vazio em local.
# TRUSTED_PROXIES=*
APP_FORCE_HTTPS=false

# ---------------------------------------------------------------------------
# Armazenamento
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
# Disco público para fotografias (public local ou s3)
ITEM_PHOTOS_DISK=public

# ---------------------------------------------------------------------------
# Serviços auxiliares
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Criação opcional do utilizador de demonstração (apenas local/testes).
SEED_DEMO_USER=false
SEED_DEMO_EMAIL=demo@campus-encontra.test
SEED_DEMO_PASSWORD=
SEED_DEMO_NAME="Utilizador de demonstração"

VITE_APP_NAME="${APP_NAME}"
