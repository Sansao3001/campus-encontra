# URL da API usada pelo frontend.
# - Desenvolvimento local: deixa vazio para usar o proxy do Vite (/api).
# - Mesmo domínio em produção: /api
# - API noutro domínio: https://api.exemplo.pt/api
VITE_API_URL=/api

# Base path dos assets. O build por omissão usa /app/ para ser servido
# pelo Laravel a partir de public/app. Para Netlify/Vercel usa /.
# VITE_BASE_PATH=/app/

# Destino do proxy de desenvolvimento (Laravel local).
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
